+    const __m128d p01 = _mm_mul_pd(d01, d01);
+    const __m128d p23 = _mm_mul_pd(d23, d23);
+    sum += _mm_cvtsd_f64(p01);
+    sum += _mm_cvtsd_f64(_mm_unpackhi_pd(p01, p01));
+    sum += _mm_cvtsd_f64(p23);
+    sum += _mm_cvtsd_f64(_mm_unpackhi_pd(p23, p23));
+  }
+#endif
+  for (; i < a.size(); ++i) {
     double d = double(a[i]) - double(p.query[i]);
