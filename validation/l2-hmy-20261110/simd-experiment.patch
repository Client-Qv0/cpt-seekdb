+  for (; i + 4 <= a.size(); i += 4) {
+    const __m128 av = _mm_loadu_ps(a.data() + i);
+    const __m128 qv = _mm_loadu_ps(p.query.data() + i);
+    const __m128d d01 = _mm_sub_pd(_mm_cvtps_pd(av), _mm_cvtps_pd(qv));
+    const __m128d d23 = _mm_sub_pd(_mm_cvtps_pd(_mm_movehl_ps(av, av)),
