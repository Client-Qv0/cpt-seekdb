+// Four rows share each loaded query block. Integer addition is exact under the
+// same 8192-dimension and [-127,127] bounds as the one-row kernel.
+__attribute__((target("avx2,no-fma"),noinline))
+inline void quantized_squared_distances4_avx2(const int8_t* codes,
+                                             const size_t* rows,
+                                             const int16_t* query,size_t dim,
+                                             uint32_t* out) {
+  const int8_t* r0=codes+rows[0]*dim;
+  const int8_t* r1=codes+rows[1]*dim;
+  const int8_t* r2=codes+rows[2]*dim;
+  const int8_t* r3=codes+rows[3]*dim;
+  __m256i s0=_mm256_setzero_si256(),s1=s0,s2=s0,s3=s0;
+  size_t d=0;
+  for(;d+16<=dim;d+=16) {
+    const __m256i q=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(query+d));
+    const __m256i a=_mm256_sub_epi16(_mm256_cvtepi8_epi16(_mm_loadu_si128(reinterpret_cast<const __m128i*>(r0+d))),q);
+    const __m256i b=_mm256_sub_epi16(_mm256_cvtepi8_epi16(_mm_loadu_si128(reinterpret_cast<const __m128i*>(r1+d))),q);
+    const __m256i c=_mm256_sub_epi16(_mm256_cvtepi8_epi16(_mm_loadu_si128(reinterpret_cast<const __m128i*>(r2+d))),q);
+    const __m256i e=_mm256_sub_epi16(_mm256_cvtepi8_epi16(_mm_loadu_si128(reinterpret_cast<const __m128i*>(r3+d))),q);
+    s0=_mm256_add_epi32(s0,_mm256_madd_epi16(a,a));
+    s1=_mm256_add_epi32(s1,_mm256_madd_epi16(b,b));
+    s2=_mm256_add_epi32(s2,_mm256_madd_epi16(c,c));
+    s3=_mm256_add_epi32(s3,_mm256_madd_epi16(e,e));
+  }
+  const __m256i sums[4]={s0,s1,s2,s3};
+  for(size_t lane=0;lane<4;++lane) {
+    __m128i halves=_mm_add_epi32(_mm256_castsi256_si128(sums[lane]),_mm256_extracti128_si256(sums[lane],1));
+    halves=_mm_hadd_epi32(halves,halves);
+    halves=_mm_hadd_epi32(halves,halves);
+    out[lane]=static_cast<uint32_t>(_mm_cvtsi128_si32(halves));
+  }
+  const int8_t* row[4]={r0,r1,r2,r3};
+  for(;d<dim;++d) for(size_t lane=0;lane<4;++lane) {
+    const int delta=int(row[lane][d])-int(query[d]);
+    out[lane]+=uint32_t(delta*delta);
+  }
