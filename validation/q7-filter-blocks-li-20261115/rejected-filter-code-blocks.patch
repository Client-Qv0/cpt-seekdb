+void test_equality_code_blocks() {
+#if (defined(__x86_64__) || defined(__i386__)) && defined(__GNUC__)
+  if(!exact::available() || std::fegetround()!=FE_TONEAREST) return;
+  exact::Plan plan({Type::BigInt,Type::BigInt,Type::Varchar,Type::Vector},3,128);
+  std::vector<std::vector<Cell>> rows;
+  const std::string text[]={"zero","one","two","three","four"};
+  for(int64_t i=0;i<45;++i) {
+    std::vector<float> vector(128);
+    for(size_t d=0;d<vector.size();++d)
+      vector[d]=float(i*3+d)/(d%2 ? 17.0f : 11.0f);
+    rows.push_back({i,(i*7)%5,text[i%5],std::move(vector)});
+    plan.observe(rows.back());
+  }
+  exact::Compact view(plan);
+  for(size_t i=0;i<rows.size();++i)
+    view.fill(i,std::get<int64_t>(rows[i][0]),rows[i]);
+  view.prepare_quantized_codes();
+  require(bool(view.quantized_codes));
+
+  const size_t before=view.allocated_bytes();
+  auto missing=view.equality_range(1,Cell(int64_t(99)),true);
+  require(missing.indexed && missing.size==0 && !missing.codes);
+  const size_t posting_only=view.allocated_bytes();
+  require(posting_only==before+view.count*sizeof(uint32_t));
+
+  for(int64_t value=0;value<5;++value) {
+    auto range=view.equality_range(1,Cell(value),true);
+    require(range.indexed && range.size && range.codes);
+    for(size_t at=0;at<range.size;++at)
+      require(std::memcmp(range.codes+at*view.dim,
+                          view.quantized_codes.get()+range.rows[at]*view.dim,
+                          view.dim)==0);
+  }
+  require(view.allocated_bytes()==posting_only+view.count*view.dim);
+  const size_t built=view.allocated_bytes();
+  for(int64_t value=0;value<5;++value) {
+    auto first=view.equality_range(1,Cell(value),true);
+    auto second=view.equality_range(1,Cell(value),true);
+    require(first.codes==second.codes && first.size==second.size);
+  }
+  require(view.allocated_bytes()==built);
+
+  exact::Plan over_code_budget({Type::BigInt,Type::BigInt,Type::Vector},2,128);
+  over_code_budget.count=12289; // 1,572,992 bytes, just over the 1.5 MiB cap.
+  require(over_code_budget.fits());
+  exact::Compact full(over_code_budget);
+  full.prepare_quantized_codes();
+  require(bool(full.quantized_codes));
+  const size_t full_before=full.allocated_bytes();
+  auto fallback=full.equality_range(1,Cell(int64_t(0)),true);
+  require(fallback.indexed && fallback.size==full.count && !fallback.codes);
+  require(full.allocated_bytes()==full_before+full.count*sizeof(uint32_t));
+  std::cout<<"equality code blocks preserve posting order and fall back at budget\n";
+#endif
+}
