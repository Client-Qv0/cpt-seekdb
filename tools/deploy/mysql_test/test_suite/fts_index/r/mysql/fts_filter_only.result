drop database if exists fts_filter_only;
create database fts_filter_only;
use fts_filter_only;
set names utf8mb4;
set ob_query_timeout = 10000000000;
result_format: 4
create table docs(id int primary key, body text, fulltext key ft(body) with parser beng);
insert into docs values (1, 'database performance audit'), (2, 'database database'),
 (3, 'performance audit'), (4, 'unrelated words'), (5, ''), (6, NULL),
 (7, 'audit database'), (8, 'the of and');
select count(*) from docs where match(body) against('database audit');
