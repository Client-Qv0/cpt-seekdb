| ["where", "who", "a", "will", "of", "an", "about", "with", "when", "what", "the"] |
+-----------------------------------------------------------------------------------+
select tokenize('The Database of the World', 'beng', '[{"output": "all"}]');
+----------------------------------------------------------------------+
| tokenize('The Database of the World', 'beng', '[{"output": "all"}]') |
+----------------------------------------------------------------------+
| {"tokens": [{"world": 1}, {"database": 1}], "doc_len": 2}            |
+----------------------------------------------------------------------+
select tokenize('The Database of the World', 'ik', '[{"output": "all"}]');
+----------------------------------------------------------------------------------+
| tokenize('The Database of the World', 'ik', '[{"output": "all"}]')               |
+----------------------------------------------------------------------------------+
| {"tokens": [{"world": 1}, {"database": 1}, {"of": 1}, {"the": 2}], "doc_len": 5} |
+----------------------------------------------------------------------------------+

create table longdoc(id int primary key, c varchar(8000));
insert into longdoc values (1, repeat('数据库全文索引 ', 300)), (2, repeat('hello world ', 400));
select id, tokenize(c, 'ik', '[{"output": "all"}]') from longdoc order by id;
+----+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| id | tokenize(c, 'ik', '[{"output": "all"}]')                                                                                                                                   |
+----+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
|  1 | {"tokens": [{"据": 600}, {"全文索引": 300}, {"全": 600}, {"引": 600}, {"数据库": 300}, {"索": 600}, {"文": 600}, {"库": 600}, {"数": 600}], "doc_len": 4800}               |
|  2 | {"tokens": [{"hello": 400}, {"world": 400}], "doc_len": 800}                                                                                                               |
+----+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
select id, tokenize(c, 'beng', '[{"output": "all"}]') from longdoc order by id;
+----+--------------------------------------------------------------+
| id | tokenize(c, 'beng', '[{"output": "all"}]')                   |
+----+--------------------------------------------------------------+
|  1 | {"tokens": [{"数据库全文索引": 300}], "doc_len": 300}        |
|  2 | {"tokens": [{"hello": 400}, {"world": 400}], "doc_len": 800} |
+----+--------------------------------------------------------------+
select id, tokenize(c, 'ik') from longdoc order by id;
+----+--------------------------------------------------------------------------------+
| id | tokenize(c, 'ik')                                                              |
+----+--------------------------------------------------------------------------------+
|  1 | ["据", "全文索引", "全", "引", "数据库", "索", "文", "库", "数"]               |
|  2 | ["hello", "world"]                                                             |
+----+--------------------------------------------------------------------------------+

