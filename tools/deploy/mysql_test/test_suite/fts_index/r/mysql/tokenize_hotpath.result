| tokenize('2024年10月27日 3.14 1,000 一二三四五 三千五百 12个 5块钱 abc123 a-b_c x@y.com', 'ik', '[{"additional_args": [{"ik_mode": "max_word"}]}]')                                                                                                 |
+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| ["5", "个", "三千五百", "123", "钱", "x", "3.14", "日", "a", "年", "c", "abc123", "12", "月", "块钱", "y", "27", "a-b_c", "2024", "二三", "b", "abc", "块", "1,000", "10", "x@y.com", "四五", "com", "一二三四五", "1", "000"]                      |
