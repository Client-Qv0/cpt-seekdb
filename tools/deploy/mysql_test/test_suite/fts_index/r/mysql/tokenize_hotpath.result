| tokenize('全文索引', 'ik', '[{"additional_args": [{"ik_mode": "max_word"}]}]')     |
+------------------------------------------------------------------------------------+
| ["索引", "全文", "全文索引"]                                                       |
+------------------------------------------------------------------------------------+
select tokenize('全文索引', 'ik', '[{"additional_args": [{"ik_mode": "bad"}]}]');
ERROR HY000: Incorrect arguments to the ik_mode should be max_word or smart
select tokenize('全文索引', 'ik');
