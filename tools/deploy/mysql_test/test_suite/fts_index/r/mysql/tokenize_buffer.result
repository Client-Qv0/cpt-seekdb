result_format: 4
set names utf8mb4;
select tokenize('FIRST Second THIRD third (Mixed-Case) ABC123', 'beng', '[{"output":"all"}]');
+-----------------------------------------------------------------------------------------------------------------+
| tokenize('FIRST Second THIRD third (Mixed-Case) ABC123', 'beng', '[{"output":"all"}]')                          |
+-----------------------------------------------------------------------------------------------------------------+
| {"tokens": [{"case": 1}, {"second": 1}, {"abc123": 1}, {"mixed": 1}, {"first": 1}, {"third": 2}], "doc_len": 7} |
+-----------------------------------------------------------------------------------------------------------------+
select tokenize(concat('FIRST ', repeat('A', 255), ' Second ', repeat('B', 256), ' THIRD ', repeat('C', 257), ' final'), 'beng', '[{"output":"all"}]');
+-------------------------------------------------------------------------------------------------------------------------------------------------+
| tokenize(concat('FIRST ', repeat('A', 255), ' Second ', repeat('B', 256), ' THIRD ', repeat('C', 257), ' final'), 'beng', '[{"output":"all"}]') |
+-------------------------------------------------------------------------------------------------------------------------------------------------+
| {"tokens": [{"second": 1}, {"third": 1}, {"final": 1}, {"first": 1}], "doc_len": 4}                                                             |
+-------------------------------------------------------------------------------------------------------------------------------------------------+
select tokenize('ÉCOLE CAFÉ ÄPFEL ΣΟΣ OceanBase 中文', 'beng');
+-----------------------------------------------------------------+
| tokenize('ÉCOLE CAFÉ ÄPFEL ΣΟΣ OceanBase 中文', 'beng')         |
+-----------------------------------------------------------------+
| ["café", "σοσ", "oceanbase", "école", "中文", "äpfel"]          |
+-----------------------------------------------------------------+
select tokenize('FIRST 中文 Second' collate utf8mb4_bin, 'beng');
+-------------------------------------------------------------+
| tokenize('FIRST 中文 Second' collate utf8mb4_bin, 'beng')   |
+-------------------------------------------------------------+
| ["second", "中文", "first"]                                 |
+-------------------------------------------------------------+
select tokenize('FIRST Second THIRD' collate utf8mb4_general_ci, 'beng');
+-------------------------------------------------------------------+
| tokenize('FIRST Second THIRD' collate utf8mb4_general_ci, 'beng') |
+-------------------------------------------------------------------+
| ["second", "first", "third"]                                      |
+-------------------------------------------------------------------+
select tokenize(concat(tokenize('FIRST Second THIRD', 'beng'), ' LAST'), 'beng');
+---------------------------------------------------------------------------+
| tokenize(concat(tokenize('FIRST Second THIRD', 'beng'), ' LAST'), 'beng') |
+---------------------------------------------------------------------------+
| ["second", "last", "third", "first"]                                      |
+---------------------------------------------------------------------------+
select tokenize('Alpha Beta Alpha', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":2},{"max_token_size":20}]}]');
+-----------------------------------------------------------------------------------------------------------------------------+
| tokenize('Alpha Beta Alpha', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":2},{"max_token_size":20}]}]') |
+-----------------------------------------------------------------------------------------------------------------------------+
| {"tokens": [{"alpha": 2}, {"beta": 1}], "doc_len": 3}                                                                       |
+-----------------------------------------------------------------------------------------------------------------------------+
select tokenize('全文索引 数据库 Database', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
+-------------------------------------------------------------------------------------------------------------------+
| tokenize('全文索引 数据库 Database', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]')        |
+-------------------------------------------------------------------------------------------------------------------+
| {"tokens": [{"database": 1}, {"数据库": 1}, {"全文索引": 1}], "doc_len": 3}                                       |
+-------------------------------------------------------------------------------------------------------------------+
select tokenize('', 'beng');
+----------------------+
| tokenize('', 'beng') |
+----------------------+
| []                   |
+----------------------+
select tokenize(NULL, 'ik');
ERROR 0A000: ik with the binary charset is not supported
