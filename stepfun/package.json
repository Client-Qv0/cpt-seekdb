{
  "name": "stepfun-local-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs --production",
    "test": "node --test test/*.test.mjs",
    "test:db": "node --test test/database.integration.mjs",
    "models": "node scripts/download-model.mjs",
    "db:up": "docker compose up -d",
    "db:ready": "node scripts/db-ready.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "express": "5.1.0",
    "seekdb": "1.4.0",
    "vite": "6.4.5"
  },
  "overrides": {
    "sharp": "0.35.5",
    "adm-zip": "0.6.1"
  }
}
